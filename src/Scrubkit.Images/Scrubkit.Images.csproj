<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>Scrubkit.Images</PackageId>
    <Title>Scrubkit.Images — Image EXIF metadata extractor for Scrubkit</Title>
    <Description>Image EXIF metadata extractor for Scrubkit powered by MetadataExtractor.</Description>
    <EnablePackageValidation>false</EnablePackageValidation>
    <PackageValidationBaselineVersion></PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scrubkit.Abstractions\Scrubkit.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" />
  </ItemGroup>

</Project>

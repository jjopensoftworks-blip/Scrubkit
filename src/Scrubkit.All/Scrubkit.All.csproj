<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>Scrubkit.All</PackageId>
    <Title>Scrubkit.All — the whole Scrubkit family in one reference</Title>
    <Description>Convenience meta-package that references the entire Scrubkit family: core engine, PDF extractor, Image EXIF extractor, email (.eml/.msg), OpenDocument, .epub, legacy binary Office (.doc/.xls/.ppt), Parquet, DI integration, Microsoft.Extensions.AI, and Semantic Kernel. Ships .AddAllExtractors() auto-registration.</Description>
    <PackageTags>scrubkit;bundle;meta;all;extraction;text-extraction;pdf;office;email;epub;opendocument;legacyoffice;parquet;offline;rag;ingestion;ai;microsoft-extensions-ai;semantic-kernel</PackageTags>
  </PropertyGroup>

  <!-- The full family. Scrubkit.Abstractions flows transitively through these. -->
  <ItemGroup>
    <ProjectReference Include="..\Scrubkit\Scrubkit.csproj" />
    <ProjectReference Include="..\Scrubkit.Pdf\Scrubkit.Pdf.csproj" />
    <ProjectReference Include="..\Scrubkit.Images\Scrubkit.Images.csproj" />
    <ProjectReference Include="..\Scrubkit.Email\Scrubkit.Email.csproj" />
    <ProjectReference Include="..\Scrubkit.OpenDocument\Scrubkit.OpenDocument.csproj" />
    <ProjectReference Include="..\Scrubkit.Epub\Scrubkit.Epub.csproj" />
    <ProjectReference Include="..\Scrubkit.LegacyOffice\Scrubkit.LegacyOffice.csproj" />
    <ProjectReference Include="..\Scrubkit.Extensions.DependencyInjection\Scrubkit.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\Scrubkit.Extensions.MicrosoftExtensionsAI\Scrubkit.Extensions.MicrosoftExtensionsAI.csproj" />
    <ProjectReference Include="..\Scrubkit.Extensions.SemanticKernel\Scrubkit.Extensions.SemanticKernel.csproj" />
  </ItemGroup>

  <!-- Parquet output is modern .NET-only, so it joins the bundle for net8.0, net9.0, and net10.0. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <ProjectReference Include="..\Scrubkit.Parquet\Scrubkit.Parquet.csproj" />
  </ItemGroup>

</Project>

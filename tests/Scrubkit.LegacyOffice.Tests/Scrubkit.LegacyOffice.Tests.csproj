<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- No coverlet.collector here on purpose (same as Scrubkit.Email.Tests): this project
         references the core Scrubkit assembly to prove end-to-end routing but exercises only
         the legacy-Office path of it, which would report the rest of core as 0% and drag the
         solution-wide coverage gate. The tests still run in CI. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scrubkit.LegacyOffice\Scrubkit.LegacyOffice.csproj" />
    <!-- Core, so we can prove the add-on routes through FolderScrubber end-to-end. -->
    <ProjectReference Include="..\..\src\Scrubkit\Scrubkit.csproj" />
  </ItemGroup>

</Project>
